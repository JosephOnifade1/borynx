# Point this at your existing local PostgreSQL test database. No shared or live data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# npm run dev enables existing test-account sign-in on loopback by default.
# Uncomment to disable it explicitly. npm run dev:demo uses a separate throwaway database.
# BORYNX_DEMO_MODE=0

# Application URL (optional, defaults to request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 3, disabled by default. Use only after approving an isolated HTTPS staging setup.
# See docs/MARKETPLACE_PHASE_3.md; keep demo flags off during email staging.
BORYNX_EMAIL_AUTH=0
BORYNX_EMAIL_SENDS=0
# BORYNX_AUTH_ORIGIN=https://staging.example.test
# BORYNX_SUPABASE_URL=https://approved-project.supabase.co
# BORYNX_SUPABASE_PUBLISHABLE_KEY=  # server-side sb_publishable_ key, not service-role/secret
# BORYNX_EMAIL_AUTH_SECRET=       # 32 random bytes, base64url; see runbook
