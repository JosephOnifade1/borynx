# Example for an empty, dedicated local PostgreSQL database. Never copy live data here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/borynx_demo

# Optional, isolated development only. Enables fictional fixtures and demo sign-in.
# Set to 1 only with a loopback borynx_demo or borynx_demo_<suffix> database.
BORYNX_DEMO_MODE=0

# Application URL (optional, defaults to request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
